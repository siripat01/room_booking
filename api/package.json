{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "lint": "biome lint --config-path=../biome.json src test scripts libs utils",
    "format": "biome format --write --config-path=../biome.json src test scripts libs utils",
    "test": "bun test test",
    "test:unit": "bun test test/unit",
    "test:routes": "bun test test/unit/routing",
    "test:integration": "bun test test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit --ignoreDeprecations 6.0",
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.10",
    "@better-auth/prisma-adapter": "^1.6.11",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "elysia": "1.4.28",
    "node-cron": "^4.5.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "resend": "^6.14.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  },
  "module": "src/index.js"
}
