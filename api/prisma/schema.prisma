generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING // รออนุมัติ
  CONFIRMED // ได้รับการอนุมัติ
  CHECKED_IN // เช็คอินแล้ว
  COMPLETED // เสร็จสิ้น (check-out แล้ว)
  CANCELLED // ยกเลิกโดย user
  REJECTED // ปฏิเสธโดย admin
  EXPIRED // ไม่มาเช็คอินภายใน grace period
}

enum BookingActorType {
  USER
  ADMIN
  DEVICE
  SYSTEM
}

enum BookingEventType {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  CHECKED_IN
  COMPLETED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  LINE
}

enum NotificationType {
  BOOKING_APPROVED
  BOOKING_REJECTED
  REMINDER_30
  CHECKIN_REMINDER
  WAITLIST_PROMOTED
  TEST
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
  CANCELLED
}

enum BackgroundJobType {
  EXPIRE_BOOKINGS
  EXPIRE_PRO_ACCESS
  AUTO_CHECKOUT
  ENQUEUE_REMINDERS
  PROMOTE_WAITLIST
  PURGE_JOB_HISTORY
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

enum AuditTargetType {
  BOOKING
  BOOKING_SERIES
  DEVICE
  ROOM
  JOB
  WAITLIST
}

enum BookingSeriesStatus {
  ACTIVE
  CANCELLED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id                     String                  @id
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  accounts               Account[]
  sessions               Session[]
  bookings               Booking[]
  bookingSeries          BookingSeries[]
  waitlistEntries        WaitlistEntry[]
  walkInDevice           Device?                 @relation("DeviceWalkInPrincipal")
  notificationPreference NotificationPreference?
  notificationJobs       NotificationJob[]
  lineLinkCodes          LineLinkCode[]

  role       String?
  isSystem   Boolean   @default(false) @map("is_system")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz(3)

  lineUserId            String?   @unique @map("line_user_id")
  // Rolling-deploy compatibility only. The migration scrubs this value and a
  // database CHECK constraint prevents obsolete LINE Notify token storage.
  legacyLineNotifyToken String?   @map("line_notify_token")
  plan                  String    @default("FREE")
  stripeCustomerId      String?   @map("stripe_customer_id")
  planExpiresAt         DateTime? @map("plan_expires_at") @db.Timestamptz(3)

  @@index([plan, planExpiresAt])
  @@index([stripeCustomerId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Room {
  id          String  @id @default(uuid())
  name        String
  description String?
  capacity    Int
  floor       String
  isActive    Boolean @default(true) @map("is_active")

  // Amenities เก็บเป็น array ของ string
  // เช่น ["projector", "whiteboard", "tv", "ac"]
  amenities    String[] @default([])
  // Roles allowed to book this room. Empty = everyone can book.
  allowedRoles String[] @default([])
  // Auto-approve bookings for this room (skip PENDING)
  autoApprove  Boolean  @default(false) @map("auto_approve")

  // Relations
  // images        RoomImage[]
  timeSlots       TimeSlot[]
  bookings        Booking[]
  bookingSeries   BookingSeries[]
  waitlistEntries WaitlistEntry[]
  device          Device?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([amenities], type: Gin)
  @@map("rooms")
}

model TimeSlot {
  id     String @id @default(uuid())
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")
  // เก็บเป็น "HH:MM" format เช่น "08:00", "18:00"
  openTime  String    @map("open_time")
  closeTime String    @map("close_time")

  isActive Boolean @default(true) @map("is_active")

  @@unique([roomId, dayOfWeek])
  @@index([roomId])
  @@map("time_slots")
}

// ─────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────

model BookingSeries {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  startDate DateTime    @map("start_date") @db.Date
  endDate   DateTime    @map("end_date") @db.Date
  weekdays  DayOfWeek[]
  startTime String      @map("start_time")
  endTime   String      @map("end_time")
  attendees Int
  purpose   String?
  status    BookingSeriesStatus @default(ACTIVE)

  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings    Booking[]

  @@index([userId, status, startDate])
  @@index([userId, createdAt])
  @@index([roomId, status, startDate])
  @@map("booking_series")
}

model Booking {
  id String @id @default(uuid())

  // Relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  seriesId         String?        @map("series_id")
  series           BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  occurrenceDate   DateTime?      @map("occurrence_date") @db.Date
  isSeriesException Boolean       @default(false) @map("is_series_exception")

  // Booking details
  startTime DateTime      @map("start_time") @db.Timestamptz(3)
  endTime   DateTime      @map("end_time") @db.Timestamptz(3)
  attendees Int
  purpose   String? // หัวข้อการประชุม / วัตถุประสงค์
  status    BookingStatus @default(PENDING)

  // Admin action
  rejectedReason String?   @map("rejected_reason")
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedBy     String?   @map("approved_by") // admin user id

  // QR Code สำหรับ check-in
  qrTokenHash String?   @unique @map("qr_token_hash")
  qrExpiresAt DateTime? @map("qr_expires_at") @db.Timestamptz(3)

  // Auditable requester information for device-created walk-in bookings.
  walkInRequesterName      String? @map("walk_in_requester_name")
  walkInRequesterReference String? @map("walk_in_requester_reference")

  // Check-in / Check-out
  checkedInAt  DateTime? @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(3)

  // ยกเลิกโดย user
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason")

  // Reminder tracking (PRO only)
  reminder30SentAt      DateTime? @map("reminder_30_sent_at") @db.Timestamptz(3)
  reminderCheckinSentAt DateTime? @map("reminder_checkin_sent_at") @db.Timestamptz(3)

  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  events           BookingEvent[]
  notificationJobs NotificationJob[]

  // index สำหรับ conflict check query
  @@index([userId])
  @@index([roomId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([roomId, startTime, endTime, status])
  @@index([status, startTime])
  @@index([status, endTime])
  @@unique([seriesId, occurrenceDate])
  @@index([seriesId, startTime])
  @@map("bookings")
}

model BookingEvent {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId    String  @map("room_id")

  actorType BookingActorType @map("actor_type")
  actorId   String?          @map("actor_id")
  eventType BookingEventType @map("event_type")

  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  metadata       Json?          @db.JsonB
  correlationId  String?        @map("correlation_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([bookingId, createdAt])
  @@index([roomId, createdAt])
  @@map("booking_events")
}

model AuditLog {
  id             String           @id @default(uuid())
  sourceEventId  String?          @unique @map("source_event_id")
  actorType      BookingActorType @map("actor_type")
  actorId        String?          @map("actor_id")
  targetType     AuditTargetType  @map("target_type")
  targetId       String           @map("target_id")
  bookingId      String?          @map("booking_id")
  deviceId       String?          @map("device_id")
  roomId         String?          @map("room_id")
  eventType      String           @map("event_type")
  previousStatus String?          @map("previous_status")
  newStatus      String?          @map("new_status")
  metadata       Json?            @db.JsonB
  correlationId  String?          @map("correlation_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([bookingId, createdAt])
  @@index([deviceId, createdAt])
  @@index([roomId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model BackgroundJob {
  id           String              @id @default(uuid())
  type         BackgroundJobType
  status       BackgroundJobStatus @default(PENDING)
  jobKey       String              @unique @map("job_key")
  scheduledFor DateTime            @map("scheduled_for") @db.Timestamptz(3)
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(5) @map("max_attempts")
  availableAt  DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt     DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedBy     String?             @map("locked_by")
  startedAt    DateTime?           @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz(3)
  lastError    String?             @map("last_error")
  result       Json?               @db.JsonB
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([type, scheduledFor])
  @@index([completedAt])
  @@map("background_jobs")
}

model StripeWebhookEvent {
  id          String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("stripe_webhook_events")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model NotificationPreference {
  userId                 String   @id @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled           Boolean  @default(true) @map("email_enabled")
  lineEnabled            Boolean  @default(true) @map("line_enabled")
  bookingUpdatesEnabled  Boolean  @default(true) @map("booking_updates_enabled")
  reminder30Enabled      Boolean  @default(true) @map("reminder_30_enabled")
  checkInReminderEnabled Boolean  @default(true) @map("check_in_reminder_enabled")
  waitlistEnabled        Boolean  @default(true) @map("waitlist_enabled")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_preferences")
}

model NotificationJob {
  id                String                @id @default(uuid())
  userId            String                @map("user_id")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId         String?               @map("booking_id")
  booking           Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  type              NotificationType
  status            NotificationJobStatus @default(PENDING)
  idempotencyKey    String                @unique @map("idempotency_key")
  payload           Json                  @db.JsonB
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(5) @map("max_attempts")
  availableAt       DateTime              @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt          DateTime?             @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?               @map("locked_by")
  lastError         String?               @map("last_error")
  providerMessageId String?               @map("provider_message_id")
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([status, updatedAt])
  @@index([userId, createdAt])
  @@index([bookingId, type])
  @@map("notification_jobs")
}

model LineLinkCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @unique @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("line_link_codes")
}

// ─────────────────────────────────────────────
// DEVICE — Kiosk หน้าห้อง
// ─────────────────────────────────────────────

model Device {
  id String @id @default(uuid())

  // ผูกกับห้องแบบ 1-to-1 (nullable — device ไม่มีห้องได้)
  roomId String? @unique @map("room_id")
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  name String // เช่น "Kiosk Room A101"

  // High-entropy credentials are stored as SHA-256 hashes. Plaintext is only
  // returned when a credential is issued or rotated.
  deviceKeyHash       String    @unique @map("device_key_hash")
  deviceKeyPrefix     String    @map("device_key_prefix")
  // Rolling-deploy compatibility sentinel; contains no credential material.
  // Remove with the constrained legacy database column in a later migration.
  legacyDeviceKey     String    @unique @map("device_key")
  credentialVersion   Int       @default(1) @map("credential_version")
  credentialRotatedAt DateTime  @default(now()) @map("credential_rotated_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)

  walkInPrincipalId String              @unique @map("walk_in_principal_id")
  walkInPrincipal   User                @relation("DeviceWalkInPrincipal", fields: [walkInPrincipalId], references: [id], onDelete: Restrict)
  pairingCodes      DevicePairingCode[]

  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lastSeenAt])
  @@map("devices")
}

model DevicePairingCode {
  id         String    @id @default(uuid())
  deviceId   String    @map("device_id")
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  codeHash   String    @unique @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([deviceId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("device_pairing_codes")
}

model RateLimitBucket {
  scope           String   @map("scope")
  subjectHash     String   @map("subject_hash")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  count           Int
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([scope, subjectHash])
  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

model RoomClosure {
  id     String @id @default(uuid())
  roomId String @map("room_id")
  // ไม่ทำ relation เพื่อให้ลบห้องได้อิสระ
  // ถ้าอยากทำ soft delete ค่อยเพิ่ม relation

  date   DateTime @db.Date // วันที่ปิด
  reason String? // เหตุผล เช่น "ซ่อมแซม"
  allDay Boolean  @default(true) @map("all_day")

  // ถ้า allDay = false ใช้ openTime/closeTime นี้แทน
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([roomId, date])
  @@map("room_closures")
}

// ─────────────────────────────────────────────
// WAITLIST
// ─────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  PROMOTED
  CANCELLED
  EXPIRED
}

model WaitlistEntry {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId     String         @map("room_id")
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startTime  DateTime       @map("start_time") @db.Timestamptz(3)
  endTime    DateTime       @map("end_time") @db.Timestamptz(3)
  attendees  Int
  purpose    String?
  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?      @map("notified_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([roomId, startTime, endTime, status])
  @@map("waitlist_entries")
}
