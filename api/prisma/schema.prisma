generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING // รออนุมัติ
  CONFIRMED // ได้รับการอนุมัติ
  CHECKED_IN // เช็คอินแล้ว
  COMPLETED // เสร็จสิ้น (check-out แล้ว)
  CANCELLED // ยกเลิกโดย user
  REJECTED // ปฏิเสธโดย admin
  EXPIRED // ไม่มาเช็คอินภายใน grace period
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Room {
  id          String  @id @default(uuid())
  name        String
  description String?
  capacity    Int
  floor       String
  isActive    Boolean @default(true) @map("is_active")

  // Amenities เก็บเป็น array ของ string
  // เช่น ["projector", "whiteboard", "tv", "ac"]
  amenities    String[] @default([])
  // Roles allowed to book this room. Empty = everyone can book.
  allowedRoles String[] @default([])
  // Auto-approve bookings for this room (skip PENDING)
  autoApprove  Boolean  @default(false) @map("auto_approve")

  // Relations
  // images        RoomImage[]
  timeSlots TimeSlot[]
  bookings  Booking[]
  device    Device?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rooms")
}

model TimeSlot {
  id     String @id @default(uuid())
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")
  // เก็บเป็น "HH:MM" format เช่น "08:00", "18:00"
  openTime  String    @map("open_time")
  closeTime String    @map("close_time")

  isActive Boolean @default(true) @map("is_active")

  @@unique([roomId, dayOfWeek])
  @@index([roomId])
  @@map("time_slots")
}

// ─────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────

model Booking {
  id String @id @default(uuid())

  // Relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId String @map("room_id")
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Booking details
  startTime DateTime      @map("start_time")
  endTime   DateTime      @map("end_time")
  attendees Int
  purpose   String? // หัวข้อการประชุม / วัตถุประสงค์
  status    BookingStatus @default(PENDING)

  // Admin action
  rejectedReason String?   @map("rejected_reason")
  approvedAt     DateTime? @map("approved_at")
  approvedBy     String?   @map("approved_by") // admin user id

  // QR Code สำหรับ check-in
  qrToken     String?   @unique @map("qr_token")
  qrExpiresAt DateTime? @map("qr_expires_at")

  // Check-in / Check-out
  checkedInAt  DateTime? @map("checked_in_at")
  checkedOutAt DateTime? @map("checked_out_at")

  // ยกเลิกโดย user
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // index สำหรับ conflict check query
  @@index([userId])
  @@index([roomId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([roomId, startTime, endTime, status])
  @@map("bookings")
}

// ─────────────────────────────────────────────
// DEVICE — Kiosk หน้าห้อง
// ─────────────────────────────────────────────

model Device {
  id String @id @default(uuid())

  // ผูกกับห้องแบบ 1-to-1 (nullable — device ไม่มีห้องได้)
  roomId String? @unique @map("room_id")
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  name      String // เช่น "Kiosk Room A101"
  // Key สำหรับ authenticate device (ไม่ใช้ JWT ของ user)
  deviceKey String @unique @map("device_key")

  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([deviceKey])
  @@map("devices")
}

model RoomClosure {
  id     String @id @default(uuid())
  roomId String @map("room_id")
  // ไม่ทำ relation เพื่อให้ลบห้องได้อิสระ
  // ถ้าอยากทำ soft delete ค่อยเพิ่ม relation

  date   DateTime @db.Date // วันที่ปิด
  reason String? // เหตุผล เช่น "ซ่อมแซม"
  allDay Boolean  @default(true) @map("all_day")

  // ถ้า allDay = false ใช้ openTime/closeTime นี้แทน
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, date])
  @@map("room_closures")
}
