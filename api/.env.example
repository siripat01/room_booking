# Database
# IMPORTANT: use the Session pooler / direct connection (port 5432), NOT the
# transaction pooler (port 6543). booking.service.ts uses an interactive
# $transaction with Serializable isolation, which the transaction pooler breaks.
DATABASE_URL=postgresql://user:password@host:5432/room_booking
# Dedicated migrated database used only by PostgreSQL integration tests
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/room_booking_test

# App
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# Booking policy (Asia/Bangkok business timezone)
BOOKING_MAX_DURATION_MINUTES=240
BOOKING_FREE_ADVANCE_DAYS=3
BOOKING_PRO_ADVANCE_DAYS=30
BOOKING_USER_ACTIVE_LIMIT=3
BOOKING_TEACHER_ACTIVE_LIMIT=5
BOOKING_PRO_ACTIVE_LIMIT=10

# Better Auth and HMAC secret for device pairing-code hashes
BETTER_AUTH_SECRET=your-secret-here-min-32-chars

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notification delivery and retry worker
# Set true in automated tests and local environments that must never contact providers.
NOTIFICATIONS_DISABLED=false
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_INTERVAL_MS=10000

# EmailNotificationProvider (Resend)
# Requires a verified sender domain in Resend.
RESEND_API_KEY=re_placeholder
EMAIL_FROM=RoomFlow <noreply@example.com>

# LineMessagingProvider and signed webhook linking
# Configure the LINE Developers webhook URL as:
# https://your-api.example.com/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=line_channel_access_token_placeholder
LINE_CHANNEL_SECRET=line_channel_secret_placeholder
LINE_BOT_BASIC_ID=@roomflow-placeholder

# Stripe compatibility billing (isolated from booking correctness)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PRICE_ID=price_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
WEB_URL=https://your-app.vercel.app
